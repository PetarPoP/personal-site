{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    // Prerendered pages are files like projects.html: serve /projects from it directly.
    "html_handling": "drop-trailing-slash"
  },
  // Guest notes and the saved Spotify token (src/lib/db.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "personal-site", "database_id": "f0e35f3a-97ca-416f-8cfe-3dec4a56d82b" }],
  // PR branches are deployed with `wrangler preview`, which must not touch the production database.
  "previews": {
    "d1_databases": [{ "binding": "DB", "database_name": "personal-site-preview", "database_id": "9ecc25de-40ee-417f-b03a-6177050734b6" }]
  },
  "observability": { "enabled": true }
}
